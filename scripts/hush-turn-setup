#!/bin/sh
# hush-turn-setup: first-enable step for hush-turn.service (#353).
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Packages ship only the template (/usr/share/hush/turnserver.conf.in, no
# credential). This writes the live coturn config with a fresh 128-bit
# secret, and hush-turn.service runs `--check` before every start.
#
# Usage:
#   hush-turn-setup               write the conf when it is absent or its
#                                 credential is not a generated secret (a
#                                 placeholder); keep a good one
#   hush-turn-setup --check [conf]
#                                 exit 0 only when every user= line is
#                                 name:<32 lowercase hex> (or a hex
#                                 static-auth-secret), and at least one exists.
#                                 Lines are read the way coturn reads them:
#                                 CR and edge blanks dropped, key and value
#                                 split by blanks or '=', one quote pair off.
#   hush-turn-setup --replace-placeholder
#                                 package upgrade step (deb postinst): only a
#                                 conf whose credential is still the old
#                                 shipped placeholder is backed up and
#                                 rewritten; anything else is left alone
#
# The conf is written 0600, owned by whoever runs this (root for the
# default path). A conf with no credential this script recognises and no
# placeholder is never overwritten: fix it by hand.
# Test seams: HUSH_TURN_CONF and HUSH_TURN_TEMPLATE override the two paths.
set -eu

conf_default=/etc/hush/turnserver.conf
conf=${HUSH_TURN_CONF:-$conf_default}
tmpl=${HUSH_TURN_TEMPLATE:-/usr/share/hush/turnserver.conf.in}
user_ok='^user=[A-Za-z0-9._-]+:[0-9a-f]{32}$'
secret_ok='^static-auth-secret=[0-9a-f]{32,}$'
placeholder='^(user=[^:]*:|static-auth-secret=)replace[-]me$'

die() { echo "hush-turn-setup: $1" >&2; exit 1; }

# Prints $1 the way coturn reads it (mainrelay.c read_config_file +
# parse_arg_string): CR and leading/trailing blanks dropped, the key split
# from its value by any run of blanks or '=', one pair of quotes removed.
norm() {
    tr -d '\r' <"$1" | sed -e 's/^[[:blank:]]*//' -e 's/[[:blank:]]*$//' \
        -e 's/^\([A-Za-z0-9-]*\)[[:blank:]=][[:blank:]=]*/\1=/' \
        -e 's/^\([A-Za-z0-9-]*\)="\(.*\)"$/\1=\2/'
}

# 0 when $1 holds at least one generated credential and no other kind.
usable() {
    [ -f "$1" ] && [ -r "$1" ] || return 1
    n=$(norm "$1")
    if printf '%s\n' "$n" | grep -q '^user='; then
        ! printf '%s\n' "$n" | grep '^user=' | grep -Evq "$user_ok" || return 1
        ! printf '%s\n' "$n" | grep -q '^static-auth-secret=' || return 1
        return 0
    fi
    printf '%s\n' "$n" | grep -q '^use-auth-secret' || return 1
    printf '%s\n' "$n" | grep -q '^static-auth-secret=' || return 1
    ! printf '%s\n' "$n" | grep '^static-auth-secret=' | grep -Evq "$secret_ok"
}

# 0 when $1 carries a credential line at all (generated or not).
has_cred() { norm "$1" | grep -Eq '^(user|static-auth-secret)='; }

# 0 when $1 still carries the placeholder older packages shipped. The
# bracket keeps that word out of this file so the packaging guard can ban it.
has_placeholder() { norm "$1" | grep -Eq "$placeholder"; }

fresh_secret() {
    s=$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')
    printf '%s' "$s" | grep -Eq '^[0-9a-f]{32}$' || die "no entropy from /dev/urandom"
    printf '%s' "$s"
}

write_conf() {
    secret=$(fresh_secret) || die "no secret"
    dir=$(dirname "$conf")
    umask 077
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/.turnserver.conf.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    grep -Ev '^(user|static-auth-secret|use-auth-secret)' "$tmpl" >"$tmp"
    printf 'user=hush:%s\n' "$secret" >>"$tmp"
    chmod 0600 "$tmp"
    mv -f "$tmp" "$conf"
    trap - EXIT
}

if [ "${1:-}" = "--check" ]; then
    target=${2:-$conf}
    usable "$target" && exit 0
    die "$target has no generated secret; run hush-turn-setup first"
fi
mode=setup
if [ "${1:-}" = "--replace-placeholder" ] && [ $# -eq 1 ]; then
    mode=upgrade
elif [ $# -ne 0 ]; then
    die "usage: hush-turn-setup [--check [conf] | --replace-placeholder]"
fi
if [ "$conf" = "$conf_default" ] && [ "$(id -u)" != 0 ]; then
    die "run as root: sudo $0"
fi
[ -r "$tmpl" ] || die "template $tmpl is missing"
if [ "$mode" = upgrade ]; then
    [ -f "$conf" ] && has_placeholder "$conf" || exit 0
    bak="$conf.placeholder-$(date +%Y%m%d%H%M%S).bak"
    cp -p "$conf" "$bak"
    write_conf
    echo "replaced the old placeholder credential in $conf (backup: $bak)"
    exit 0
fi
if usable "$conf"; then
    echo "kept $conf (it already has a generated secret)"
elif [ -e "$conf" ] && ! has_cred "$conf"; then
    die "$conf has no credential this script recognises; edit it by hand"
else
    write_conf
    echo "wrote $conf (0600) with a fresh 32-hex secret"
fi
echo "next: sudo systemctl enable --now hush-turn"
