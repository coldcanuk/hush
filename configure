#!/bin/sh
# configure - Hush build configuration (Linux + *BSD)
# POSIX sh. Detects OS via uname + /etc/os-release fallback.
# Checks for C11 compiler (gcc/clang), make/gmake, install.
# Runs strict C11 probe. Writes config.mk.
# Prints OS-specific install hints.
# Respects PREFIX, BINDIR, DATADIR from env or args.
#
# Usage:
#   ./configure
#   PREFIX=$HOME/.local ./configure
#   ./configure --prefix=/opt/hush
#
# After: cat config.mk && make && make test

set -e

# Defaults
PREFIX="${PREFIX:-/usr/local}"
BINDIR="${BINDIR:-${PREFIX}/bin}"
DATADIR="${DATADIR:-${PREFIX}/share/hush}"
CC="${CC:-}"
MAKE="${MAKE:-}"

# Parse simple args (support --prefix=...)
for arg in "$@"; do
    case "$arg" in
        --prefix=*)
            PREFIX="${arg#--prefix=}"
            BINDIR="${BINDIR:-${PREFIX}/bin}"
            DATADIR="${DATADIR:-${PREFIX}/share/hush}"
            ;;
        --bindir=*)
            BINDIR="${arg#--bindir=}"
            ;;
        --datadir=*)
            DATADIR="${arg#--datadir=}"
            ;;
        --cc=*)
            CC="${arg#--cc=}"
            ;;
        --make=*)
            MAKE="${arg#--make=}"
            ;;
        -h|--help)
            echo "configure for Hush (hush-c legible C11 relay)"
            echo "Options: --prefix=PATH --bindir=PATH --datadir=PATH --cc=PATH --make=PATH"
            echo "Env vars: PREFIX BINDIR DATADIR CC MAKE"
            exit 0
            ;;
    esac
done

echo "=== Hush Configuration ==="
echo "Target PREFIX:  $PREFIX"
echo "Binary dir:     $BINDIR"
echo "Data dir:       $DATADIR"
echo

# OS detection (Linux and *BSD primary)
OS_UNAME="$(uname -s 2>/dev/null || echo unknown)"
OS_RELEASE_ID=""
OS_RELEASE_LIKE=""
if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    OS_RELEASE_ID="${ID:-}"
    OS_RELEASE_LIKE="${ID_LIKE:-}"
fi

echo "Detected: uname=${OS_UNAME} os-release=${OS_RELEASE_ID:-unknown} (like: ${OS_RELEASE_LIKE:-})"
echo

# Choose compiler if not forced
if [ -z "$CC" ]; then
    if command -v gcc >/dev/null 2>&1; then
        CC="gcc"
    elif command -v clang >/dev/null 2>&1; then
        CC="clang"
    else
        CC="cc"
    fi
fi

# Choose make (prefer gmake on BSD, fall back to make)
if [ -z "$MAKE" ]; then
    if [ "$OS_UNAME" = "FreeBSD" ] || [ "$OS_UNAME" = "OpenBSD" ] || [ "$OS_UNAME" = "NetBSD" ]; then
        if command -v gmake >/dev/null 2>&1; then
            MAKE="gmake"
        else
            MAKE="make"
        fi
    else
        if command -v gmake >/dev/null 2>&1; then
            MAKE="gmake"
        elif command -v make >/dev/null 2>&1; then
            MAKE="make"
        else
            MAKE="make"
        fi
    fi
fi

echo "Using CC:   $CC"
echo "Using MAKE: $MAKE"
echo

# Requirement checks
MISSING=""
check_cmd() {
    cmd="$1"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "MISSING: $cmd"
        MISSING="$MISSING $cmd"
    else
        echo "FOUND:   $cmd ($(command -v "$cmd"))"
    fi
}

echo "Checking build requirements..."
check_cmd "$CC"
check_cmd "$MAKE"
check_cmd install

# C11 capability probe with strict flags (same as hush-c/Makefile)
echo
echo "Testing C11 + strict flags capability..."
cat > /tmp/hush_c11_probe.c << 'PROBE'
#include <stdio.h>
#include <stdint.h>
#include <stdbool.h>
#include <poll.h>
#include <sys/socket.h>
int main(void) {
    uint32_t x = 42;
    bool ok = (x == 42);
    (void)ok;
    printf("C11 probe: OK (poll+socket+stdint)\n");
    return 0;
}
PROBE

C11_OK=0
if "$CC" -std=c11 -Wall -Wextra -Werror -Wconversion -Wshadow -c /tmp/hush_c11_probe.c -o /tmp/hush_c11_probe.o >/dev/null 2>&1; then
    echo "C11 strict probe: PASSED"
    C11_OK=1
    rm -f /tmp/hush_c11_probe.*
else
    echo "C11 strict probe: FAILED"
    MISSING="$MISSING c11-strict"
fi

# OS-specific hints
echo
case "$OS_UNAME" in
    Linux)
        if [ "$OS_RELEASE_ID" = "pop" ] || echo "$OS_RELEASE_LIKE" | grep -qi "ubuntu\|debian"; then
            echo ">>> Linux (Debian/Ubuntu/Pop!_OS) detected <<<"
            echo "Recommended:"
            echo "  sudo apt update"
            echo "  sudo apt install -y build-essential pkg-config"
        else
            echo ">>> Linux detected <<<"
            echo "Install build tools for your distro (gcc/clang + make)."
        fi
        ;;
    FreeBSD)
        echo ">>> FreeBSD detected <<<"
        echo "Recommended (as root or with doas/pkg):"
        echo "  pkg install -y gmake gcc pkgconf"
        echo "  # then use gmake after configure if needed"
        ;;
    OpenBSD)
        echo ">>> OpenBSD detected <<<"
        echo "Recommended (as root):"
        echo "  pkg_add gmake"
        echo "  # CC=cc is usually clang; configure will pick it"
        ;;
    NetBSD)
        echo ">>> NetBSD detected <<<"
        echo "Recommended:"
        echo "  pkgin install gmake gcc pkgconf"
        ;;
    Darwin)
        echo ">>> macOS (Darwin) detected <<<"
        echo "Use Xcode command line tools or brew install make (gmake)."
        ;;
    *)
        echo ">>> Unknown or other POSIX OS: $OS_UNAME <<<"
        echo "Ensure a C11 compiler and GNU/BSD make are available."
        ;;
esac

# Write config.mk (consumed by top Makefile and/or hush-c)
cat > config.mk << CONF
# Generated by ./configure on $(date -u +%Y-%m-%dT%H:%M:%SZ)
# Do not edit by hand. Re-run ./configure to change.

PREFIX  := $PREFIX
BINDIR  := $BINDIR
DATADIR := $DATADIR

CC      := $CC
MAKE    := $MAKE

OS_UNAME := $OS_UNAME
OS_ID    := ${OS_RELEASE_ID:-unknown}

# CFLAGS for legible C11 (hush-c)
CFLAGS  := -std=c11 -Wall -Wextra -Werror -Wconversion -Wshadow -Iinclude -O2
CONF

echo
echo "Configuration written to config.mk"
echo "PREFIX=$PREFIX BINDIR=$BINDIR"
echo
echo "Next steps:"
echo "  $MAKE -C hush-c          # or just 'make' if top Makefile present"
echo "  $MAKE -C hush-c test"
echo "  $MAKE -C hush-c install PREFIX=\$HOME/.local"
echo
if [ -n "$MISSING" ]; then
    echo "WARNING: Missing or insufficient:$MISSING"
    echo "Install the missing items and re-run ./configure"
    exit 1
fi

echo "All requirements satisfied for Hush C build."
exit 0
