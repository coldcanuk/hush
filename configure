#!/bin/sh
# configure - Hush build configuration (Linux + *BSD)
# POSIX sh.
# - Detects OS (uname + /etc/os-release)
# - Checks C11 compiler, make/gmake, install
# - Strict C11 probe
# - Writes config.mk
# - Special good UX for Pop!_OS (and other Debian/Ubuntu)
#
# Invocation:
#   ./configure
#   ./configure --prefix=/usr
#   ./configure --prefix=/opt/hush --bindir=/opt/hush/bin

set -e

# Start with environment values if present. `${PREFIX+x}` distinguishes
# "unset" from "set but empty": an explicitly empty PREFIX is a caller
# error (refused below), never a silent fallback to $HOME/.local.
PREFIX_EXPLICIT=0
if [ -z "${PREFIX+x}" ]; then
    PREFIX="$HOME/.local"
else
    PREFIX_EXPLICIT=1
fi
BINDIR="${BINDIR:-}"
DATADIR="${DATADIR:-}"
CC="${CC:-}"
MAKE_CMD="${MAKE:-}"
ENABLE_STUN_TURN="${ENABLE_STUN_TURN:-1}"

# Parse command-line options (override env). Both `--opt=val` flags and
# autoconf-style `VAR=value` assignments are honored; flags win when both
# set the same variable.
for arg in "$@"; do
    case "$arg" in
        --prefix=*)   PREFIX="${arg#--prefix=}"; PREFIX_EXPLICIT=1 ;;
        --bindir=*)   BINDIR="${arg#--bindir=}" ;;
        --datadir=*)  DATADIR="${arg#--datadir=}" ;;
        --cc=*)       CC="${arg#--cc=}" ;;
        --make=*)     MAKE_CMD="${arg#--make=}" ;;
        --enable-stun-turn)  ENABLE_STUN_TURN=1 ;;
        --disable-stun-turn) ENABLE_STUN_TURN=0 ;;
        PREFIX=*)     PREFIX="${arg#PREFIX=}"; PREFIX_EXPLICIT=1 ;;
        BINDIR=*)     BINDIR="${arg#BINDIR=}" ;;
        DATADIR=*)    DATADIR="${arg#DATADIR=}" ;;
        CC=*)         CC="${arg#CC=}" ;;
        MAKE=*)       MAKE_CMD="${arg#MAKE=}" ;;
        ENABLE_STUN_TURN=*) ENABLE_STUN_TURN="${arg#ENABLE_STUN_TURN=}" ;;
        -h|--help)
            echo "configure for Hush (hush-relay - legible C11 Nostr relay)"
            echo ""
            echo "Options:"
            echo "  --prefix=PATH   Installation prefix (default: \$HOME/.local)"
            echo "  --bindir=PATH   Binary directory   (default: \$PREFIX/bin)"
            echo "  --datadir=PATH  Data directory     (default: \$PREFIX/share)"
            echo "  --cc=COMPILER   C compiler"
            echo "  --make=MAKE     make or gmake"
            echo "  --enable-stun-turn   STUN/TURN runtime + templates (default; hush_turn.c always compiles)"
            echo "  --disable-stun-turn  soft-off: skip STUN/TURN templates + runtime (hush_turn.c still compiles)"
            echo ""
            echo "VAR=value assignments are also honored (PREFIX=/tmp/hush-eval"
            echo "./configure, or ./configure PREFIX=/tmp/hush-eval); flags win."
            echo ""
            echo "Isolated eval install (never touches \$HOME/.local):"
            echo "  ./configure --prefix=/tmp/hush-eval && make && make install"
            echo ""
            echo "An explicitly empty PREFIX is refused: unset PREFIX to accept"
            echo "the default instead of passing an empty value."
            exit 0
            ;;
        *)
            echo "configure: warning: ignoring unknown argument: $arg" >&2
            ;;
    esac
done

# An explicitly empty PREFIX (./configure PREFIX=, ./configure --prefix=,
# or PREFIX= ./configure) is refused: deriving BINDIR from it would yield
# /bin, and silently falling back to $HOME/.local would clobber the shared
# user prefix the caller tried to avoid.
if [ "$PREFIX_EXPLICIT" = "1" ] && [ -z "$PREFIX" ]; then
    echo "configure: error: empty PREFIX was explicitly requested." >&2
    echo "configure: error: for an isolated install, pass a real prefix:" >&2
    echo "configure: error:   ./configure --prefix=/tmp/hush-eval" >&2
    echo "configure: error: or unset PREFIX to accept the default ($HOME/.local)." >&2
    exit 1
fi

# Derive BINDIR and DATADIR from PREFIX only if they were not explicitly provided
if [ -z "$BINDIR" ]; then
    BINDIR="${PREFIX}/bin"
fi
if [ -z "$DATADIR" ]; then
    DATADIR="${PREFIX}/share"
fi

echo "=== Hush Configuration ==="
echo "Target PREFIX:  $PREFIX"
echo "Binary dir:     $BINDIR"
echo "Data dir:       $DATADIR"
echo

# OS detection
OS_UNAME="$(uname -s 2>/dev/null || echo unknown)"
OS_RELEASE_ID=""
OS_RELEASE_LIKE=""
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS_RELEASE_ID="${ID:-}"
    OS_RELEASE_LIKE="${ID_LIKE:-}"
fi

echo "Detected: uname=${OS_UNAME}  os-release=${OS_RELEASE_ID:-unknown} (like: ${OS_RELEASE_LIKE:-})"
echo

# Choose compiler
if [ -z "$CC" ]; then
    if command -v gcc >/dev/null 2>&1; then
        CC=gcc
    elif command -v clang >/dev/null 2>&1; then
        CC=clang
    else
        CC=cc
    fi
fi

# Choose make (prefer gmake on BSDs)
if [ -z "$MAKE_CMD" ]; then
    if [ "$OS_UNAME" = "FreeBSD" ] || [ "$OS_UNAME" = "OpenBSD" ] || [ "$OS_UNAME" = "NetBSD" ]; then
        if command -v gmake >/dev/null 2>&1; then MAKE_CMD=gmake; else MAKE_CMD=make; fi
    else
        if command -v gmake >/dev/null 2>&1; then MAKE_CMD=gmake; else MAKE_CMD=make; fi
    fi
fi

echo "Using CC:   $CC"
echo "Using MAKE: $MAKE_CMD"
if [ "$ENABLE_STUN_TURN" = "1" ]; then
    echo "STUN/TURN:  enabled (default; --disable-stun-turn for soft-off)"
else
    echo "STUN/TURN:  soft-off (templates skipped; hush_turn.c still compiles)"
fi
echo

MISSING=""
check_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "MISSING: $1"
        MISSING="$MISSING $1"
    else
        echo "FOUND:   $1 ($(command -v "$1"))"
    fi
}

echo "Checking build requirements..."
check_cmd "$CC"
check_cmd "$MAKE_CMD"
check_cmd install
check_cmd python3

TURNSERVER=""
if command -v turnserver >/dev/null 2>&1; then
    TURNSERVER="$(command -v turnserver)"
    echo "FOUND:   turnserver ($TURNSERVER)"
else
    echo "OPTIONAL: turnserver (coturn) not on PATH"
    echo "          install coturn to start a STUN/TURN server from Settings."
fi

echo
echo "Testing C11 compiler capability (strict flags)..."
cat > /tmp/hush_c11_probe.c << 'PROBE'
#include <stdio.h>
#include <stdint.h>
#include <stdbool.h>
#include <poll.h>
#include <sys/socket.h>
int main(void) {
    uint32_t x = 42;
    bool ok = (x == 42);
    (void)ok;
    printf("C11 probe: OK\n");
    return 0;
}
PROBE

if "$CC" -std=c11 -Wall -Wextra -Werror -Wconversion -Wshadow -c /tmp/hush_c11_probe.c -o /tmp/hush_c11_probe.o >/dev/null 2>&1; then
    echo "C11 strict probe: PASSED"
    rm -f /tmp/hush_c11_probe.*
else
    echo "C11 strict probe: FAILED"
    MISSING="$MISSING c11-strict"
fi

# Optional hardening: probe each flag so unknown-flag errors cannot break the
# build on a platform whose toolchain lacks it.
echo "Testing optional hardening flags..."
cat > /tmp/hush_harden_probe.c << 'PROBE'
int main(void) {
    return 0;
}
PROBE
HARDEN_CFLAGS=""
HARDEN_LDFLAGS=""
probe_cflag() {
    if "$CC" $1 -c /tmp/hush_harden_probe.c -o /tmp/hush_harden_probe.o >/dev/null 2>&1; then
        HARDEN_CFLAGS="$HARDEN_CFLAGS $1"
        echo "HARDEN:  $1"
    else
        echo "SKIP:    $1 (unsupported)"
    fi
}
probe_ldflag() {
    if "$CC" $HARDEN_CFLAGS /tmp/hush_harden_probe.o $1 -o /tmp/hush_harden_probe >/dev/null 2>&1; then
        HARDEN_LDFLAGS="$HARDEN_LDFLAGS $1"
        echo "HARDEN:  $1"
    else
        echo "SKIP:    $1 (unsupported)"
    fi
}
probe_cflag "-fstack-protector-strong"
probe_cflag "-O2 -D_FORTIFY_SOURCE=2"
probe_cflag "-fPIE"
probe_ldflag "-Wl,-z,relro"
probe_ldflag "-Wl,-z,now"
probe_ldflag "-pie"
rm -f /tmp/hush_harden_probe.c /tmp/hush_harden_probe.o /tmp/hush_harden_probe

OPENSSL_CFLAGS=""
OPENSSL_LIBS="-lcrypto"
X11_CFLAGS=""
X11_LIBS=""
if [ -f /usr/include/openssl/bn.h ]; then
    echo "FOUND:   openssl headers (/usr/include/openssl)"
elif [ -f /usr/include/node/openssl/bn.h ]; then
    OPENSSL_CFLAGS="-I/usr/include/node"
    echo "FOUND:   openssl headers (/usr/include/node)"
    if [ ! -e /usr/lib/$(uname -m)-linux-gnu/libcrypto.so ] && \
       [ -e /usr/lib/$(uname -m)-linux-gnu/libcrypto.so.3 ]; then
        OPENSSL_LIBS="-l:libcrypto.so.3"
    fi
else
    echo "MISSING: openssl headers (libssl-dev)"
    MISSING="$MISSING openssl"
fi

if [ -f /usr/include/X11/Xlib.h ]; then
    X11_CFLAGS="-DHUSH_HAVE_X11=1"
    X11_LIBS="-lX11"
    echo "FOUND:   X11 headers (/usr/include/X11) — window min/max/undecorate on"
else
    echo "OPTIONAL: X11 headers not found (libx11-dev). Minimize/Maximize become no-ops."
fi

# Helpful output, especially for Pop!_OS
echo
case "$OS_UNAME" in
    Linux)
        if [ "$OS_RELEASE_ID" = "pop" ] || echo "$OS_RELEASE_LIKE" | grep -qi "pop\|ubuntu\|debian"; then
            echo ">>> Linux (Debian/Ubuntu/Pop!_OS) detected <<<"
            echo "For the optimal experience on Pop!_OS run:"
            echo "  sudo apt update"
            echo "  sudo apt install -y build-essential pkg-config"
            echo "This ensures gcc, make, and all required headers are present."
        else
            echo ">>> Linux detected <<<"
            echo "Install build tools for your distribution (gcc/clang + make)."
        fi
        ;;
    FreeBSD)
        echo ">>> FreeBSD detected <<<"
        echo "Recommended:"
        echo "  pkg install -y gmake gcc pkgconf"
        ;;
    OpenBSD)
        echo ">>> OpenBSD detected <<<"
        echo "Recommended:"
        echo "  pkg_add gmake"
        ;;
    NetBSD)
        echo ">>> NetBSD detected <<<"
        echo "Recommended:"
        echo "  pkgin install gmake gcc pkgconf"
        ;;
    *)
        echo ">>> $OS_UNAME <<<"
        ;;
esac

# Build stamp: version + short commit baked into the binary at build time,
# so the main display proves which build is running (no runtime git needed).
HUSH_BUILD_VERSION=""
if command -v git >/dev/null 2>&1; then
    HUSH_BUILD_VERSION="$(git describe --tags --always --dirty 2>/dev/null || true)"
fi
if [ -z "$HUSH_BUILD_VERSION" ] && [ -f VERSION ]; then
    HUSH_BUILD_VERSION="$(cat VERSION)"
fi
HUSH_BUILD_SHA=""
if command -v git >/dev/null 2>&1; then
    HUSH_BUILD_SHA="$(git rev-parse --short HEAD 2>/dev/null || true)"
fi
if [ -z "$HUSH_BUILD_SHA" ]; then
    HUSH_BUILD_SHA="unknown"
fi
# Keep only stamp-safe characters before embedding in a -D string literal.
HUSH_BUILD_VERSION="$(printf '%s' "$HUSH_BUILD_VERSION" | tr -cd 'A-Za-z0-9._+-')"
HUSH_BUILD_SHA="$(printf '%s' "$HUSH_BUILD_SHA" | tr -cd 'A-Za-z0-9._+-')"
if [ -z "$HUSH_BUILD_VERSION" ]; then
    HUSH_BUILD_VERSION="0.0.1"
fi
echo "Build stamp: $HUSH_BUILD_VERSION ($HUSH_BUILD_SHA)"
echo

# Write config.mk (used by top-level Makefile and hush-c)
cat > config.mk << CONF
# Generated by ./configure on $(date -u +%Y-%m-%dT%H:%M:%SZ)
# Re-run ./configure to change.

PREFIX  := $PREFIX
BINDIR  := $BINDIR
DATADIR := $DATADIR

CC      := $CC
MAKE    := $MAKE_CMD

OS_UNAME := $OS_UNAME
OS_ID    := ${OS_RELEASE_ID:-unknown}

# Legible C11 flags (matching hush-c expectations)
CFLAGS  := -std=c11 -Wall -Wextra -Werror -Wconversion -Wshadow -Iinclude -O2 -DHUSH_STUN_TURN=$ENABLE_STUN_TURN $OPENSSL_CFLAGS $X11_CFLAGS$HARDEN_CFLAGS
LDFLAGS := $OPENSSL_LIBS $X11_LIBS$HARDEN_LDFLAGS

ENABLE_STUN_TURN := $ENABLE_STUN_TURN
TURNSERVER := $TURNSERVER

# Build stamp (git describe + short HEAD) for the main-display proof.
# hush-c/Makefile turns these into -D string flags like the share paths.
HUSH_BUILD_VERSION := $HUSH_BUILD_VERSION
HUSH_BUILD_SHA := $HUSH_BUILD_SHA
CONF

echo
echo "Configuration written to config.mk"
echo "  PREFIX=$PREFIX"
echo "  BINDIR=$BINDIR"
echo "  DATADIR=$DATADIR"
echo "  STUN/TURN=$ENABLE_STUN_TURN"
echo "  BUILD=$HUSH_BUILD_VERSION ($HUSH_BUILD_SHA)"
echo
echo "Standard workflow:"
echo "  ./configure"
echo "  make"
echo "  make test"
echo "  make install                 # installs to \$HOME/.local (no sudo needed)"
echo "  sudo make install PREFIX=/usr  # system-wide install"
echo
echo "After install, you may want:"
echo "  update-desktop-database \$HOME/.local/share/applications || true"
echo

if [ -n "$MISSING" ]; then
    echo "WARNING: Missing or insufficient tools:$MISSING"
    exit 1
fi

echo "All requirements satisfied for Hush C build."
exit 0
